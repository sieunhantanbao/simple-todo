      "variant": "shortText"
    },
    {
      "id": "req-submit",
      "component": "Button",
      "variant": "primary",
      "child": "req-submit-label",
      "checks": [
        {
          "condition": {
            "call": "required",
            "args": {
              "value": {
                "path": "/requirements/workload"
              }
            },
            "returnType": "boolean"
