      "options": [
        {
          "label": "Standard",
          "value": "Standard"
        },
        {
          "label": "High availability",
          "value": "High availability"
        },
        {
          "label": "Mission-critical",
          "value": "Mission-critical"
        },
        {
          "label": "Not decided",
          "value": "Not decided"
        }
      ]
    },
    {
      "id": "req-security",
      "component": "TextField",
      "label": "Security / compliance constraints",
      "value": {
        "path": "/requirements/security"
      },
      "variant": "shortText"
