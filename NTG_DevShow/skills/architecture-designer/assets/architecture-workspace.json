{
  "surfaceId": "architecture-workspace",
  "components": [
    {
      "id": "root",
      "component": "Column",
      "children": [
        "wizard"
      ]
    },
    {
      "id": "wizard",
      "component": "Tabs",
      "tabs": [
        {
          "title": "1. Requirements",
          "child": "requirements-pane"
        },
        {
          "title": "2. Options",
          "child": "options-pane"
        },
        {
          "title": "3. Decision",
          "child": "decision-pane"
        }
      ]
    },
    {
      "id": "requirements-pane",
      "component": "Column",
      "children": [
        "req-title",
        "req-hint",
        "req-workload",
        "req-cloud",
        "req-users",
        "req-data",
        "req-availability",
        "req-security",
        "req-budget",
        "req-priority",
        "req-submit"
      ]
    },
    {
      "id": "req-title",
      "component": "Text",
      "text": "Architecture design brief",
      "variant": "h4"
    },
    {
      "id": "req-hint",
      "component": "Text",
      "text": "Describe the system and constraints. The agent will compare three designs; assumptions will be called out.",
      "variant": "caption"
    },
    {
      "id": "req-workload",
      "component": "TextField",
      "label": "What are we building?",
      "value": {
        "path": "/requirements/workload"
      },
      "variant": "shortText"
    },
    {
      "id": "req-cloud",
      "component": "ChoicePicker",
      "label": "Preferred platform",
      "variant": "mutuallyExclusive",
      "value": {
        "path": "/requirements/cloud"
      },
      "options": [
        {
          "label": "Azure",
          "value": "Azure"
        },
        {
          "label": "AWS",
          "value": "AWS"
        },
        {
          "label": "Google Cloud",
          "value": "Google Cloud"
        },
        {
          "label": "Cloud-agnostic / undecided",
          "value": "Undecided"
        }
      ]
    },
    {
      "id": "req-users",
      "component": "TextField",
      "label": "Expected scale / traffic",
      "value": {
        "path": "/requirements/scale"
      },
      "variant": "shortText"
    },
    {
      "id": "req-data",
      "component": "TextField",
      "label": "Data and integration needs",
